# Template only — real values live on the app host only, in
# /opt/data-etc/mattermost-jitsi/config.env (never commit real values here).
# Copy to config.env and fill in. Generate secrets with:
#   openssl rand -hex 32

# --- Routing ---
# Public FQDNs (placeholders)
DOMAIN_MM=
DOMAIN_JITSI=

# Public IPv4 of the site, advertised by JVB clients for UDP 10000 (placeholder)
PUBLIC_SERVER_IP=

# --- Mattermost database ---
MM_DB_USER=
MM_DB_PASSWORD=
MM_DB_NAME=

# --- Mattermost ---
# Initial sysadmin account password
MM_SERVICE_PASSWORD=
MM_SECRET_KEY=

# --- Jitsi ---
# JWT shared app id/secret (must match the Mattermost Jitsi plugin settings)
JWT_APP_ID=
JITSI_JWT_SECRET=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
