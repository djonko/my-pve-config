# -------------------------------------------------------------------
# PUBLIC URL
# -------------------------------------------------------------------
PROJECT_URL=https://portabase.yourdomain.com

# -------------------------------------------------------------------
# SECRETS
# -------------------------------------------------------------------
PROJECT_SECRET=a_super_secret_hex_key_change_me_64bytes
POSTGRES_PASSWORD=SecretPostgresPassword123!

# -------------------------------------------------------------------
# INTERNAL METADATA DATABASE
# -------------------------------------------------------------------
POSTGRES_USER=portabase
POSTGRES_DB=portabase
POSTGRES_HOST=portabase-db
POSTGRES_PORT=5432

# -------------------------------------------------------------------
# REVERSE PROXY / TRAEFIK CONFIGURATION
# -------------------------------------------------------------------
TRUST_PROXY=true
TUSD_BEHIND_PROXY=true

# -------------------------------------------------------------------
# PRIVACY / TELEMETRY
# -------------------------------------------------------------------
TELEMETRY=false

# API & MCP
API_ENABLED=true
OPENAPI_ENABLED=false
MCP_ENABLED=false

# Logs
LOG_LEVEL=info

# SMTP
SMTP_HOST=true
SMTP_PORT=true
SMTP_USER=true
SMTP_PASSWORD=true
SMTP_SECURE=true

# default user
AUTH_DEFAULT_USER_NAME=
AUTH_DEFAULT_USER=
AUTH_DEFAULT_PASSWORD=
