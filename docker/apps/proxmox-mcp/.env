# Environment variables for proxmox-mcp-server

# Token required for authentication (secret)
MCP_AUTH_TOKEN="YOUR_SECRET_TOKEN_HERE"

# Proxy/Proxmox Configuration Variables
PROXMOX_HOST="your_proxmox_host"
PROXMOX_PORT="8006" # Default Proxmox GUI port
PROXMOX_TOKEN_NAME="your_api_token_name"
PROXMOX_TOKEN_VALUE="your_api_token_value"

# Server Configuration (These variables are often set as environment variables in Docker Compose)
# MCP_HTTP_HOST is set to 0.0.0.0 in the compose file
MCP_HTTP_HOST=0.0.0.0 
PROXMOX_VERIFY_SSL=false
PROXMOX_READ_ONLY=true
LOG_LEVEL=INFO
